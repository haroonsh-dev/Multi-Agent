{
  "name": "docugemma-ai-api-gateway",
  "version": "1.0.0",
  "description": "DocuGemma AI API Gateway — Express + MongoDB + Open-Weight Intelligence",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:legacy": "nodemon src/server.ts",
    "build": "tsc",
    "test:role-permissions": "tsx --tsconfig tsconfig.json src/scripts/testRolePermissions.ts",
    "test:supervision": "tsx --tsconfig tsconfig.json src/scripts/testSupervision.ts",
    "test:integration-duplicates": "tsx --tsconfig tsconfig.json src/scripts/testIntegrationDuplicates.ts",
    "test:agent-entitlements": "tsx --tsconfig tsconfig.json src/scripts/testAgentEntitlements.ts",
    "test:document-name-match": "tsx --tsconfig tsconfig.json src/scripts/testDocumentNameMatch.ts",
    "test:analytics-intent": "tsx --tsconfig tsconfig.json src/scripts/testAnalyticsIntent.ts",
    "test:finance-golden": "tsx --tsconfig tsconfig.json src/scripts/testFinanceGolden.ts",
    "test:catalog-drift": "tsx --tsconfig tsconfig.json src/scripts/checkCatalogDrift.ts",
    "test:integration-ingest-url": "tsx --tsconfig tsconfig.json src/scripts/testIntegrationIngestUrl.ts",
    "test:clickup-bridge": "tsx --tsconfig tsconfig.json src/scripts/testClickUpBridge.ts",
    "test:policy-blocks-send": "tsx --tsconfig tsconfig.json src/scripts/testPolicyBlocksSend.ts",
    "test:agent-api": "tsx --tsconfig tsconfig.json src/scripts/testAgentApi.ts",
    "eval:accuracy": "tsx --tsconfig tsconfig.json src/scripts/evalDocumentAccuracy.ts",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:plans": "tsx src/scripts/seedPlans.ts",
    "seed": "tsx src/scripts/seedAdmin.ts"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "form-data": "^4.0.6",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/form-data": "^2.2.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3"
  }
}
