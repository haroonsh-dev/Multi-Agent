PORT=5100
NODE_ENV=development

# Memory / runtime tuning (optional)
# JSON_BODY_LIMIT=2mb
# MONGO_MAX_POOL_SIZE=5
# BACKGROUND_TICK_MS=120000
# DISABLE_BACKGROUND_JOBS=false

# MongoDB — separate DB name so it won't clash with Visibility Live
# Replace with your real connection string (never commit real credentials).
MONGO_URI=mongodb://localhost:27017/visibility_docs_ai

# JWT (use same secrets as live if you want shared tokens later)
JWT_SECRET=change-me-docs-ai-jwt-secret
JWT_REFRESH_SECRET=change-me-docs-ai-refresh-secret
JWT_EXPIRE=30d
JWT_REFRESH_EXPIRE=7d
JWT_COOKIE_EXPIRE=30
BCRYPT_SALT_ROUNDS=12

# AI service (Python FastAPI) — internal, not exposed to frontend
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=300000
# Chat/RAG can run longer than generic AI calls
AI_CHAT_TIMEOUT_MS=300000
AI_SERVICE_ENABLED=true
# Shared secret presented to the ai-backend on every call (must match
# ai-backend's INTERNAL_SERVICE_KEY). Production MUST override this.
AI_INTERNAL_SERVICE_KEY=dev-internal-service-key

# Shared file storage — same folder as Python ai-backend uses
# Default: ../shared-storage (VM-main root)
SHARED_STORAGE_PATH=

# Public URL for integration ingest (required in production for external systems)
# PUBLIC_API_URL=https://api.yourdomain.com

# Integration ingest tuning (optional)
# INTEGRATION_INGEST_MAX_BYTES=52428800
# INTEGRATION_INGEST_FETCH_TIMEOUT_MS=60000
# INTEGRATION_INGEST_RATE_LIMIT=180
#
# ClickUp: configure per-org in Admin → Integrations (API token stored on connection).
# Universal push URL (SAP AP, MasterControl QC, …): {PUBLIC_API_URL}/api/docs/integrations/connections/{connectionId}/push?key={ingestKey}
# Shared ingest URL: {PUBLIC_API_URL}/api/docs/integrations/ingest  + header X-Integration-Key

# OpenRemote / Keycloak — same env names as Visibility Live for easy merge
OPENREMOTE_ENABLED=true
OPENREMOTE_BASE_URL=http://localhost:8080
OPENREMOTE_REALM=master
OPENREMOTE_ADMIN_USERNAME=admin
OPENREMOTE_ADMIN_PASSWORD=secret
OPENREMOTE_MASTER_USERNAME=admin
OPENREMOTE_MASTER_PASSWORD=secret
OPENREMOTE_VERIFY_SSL=false

# Optional seed users (npm run seed) — dev/test only. The seed script now
# REFUSES to run without these set; never use these example values in production.
SEED_SUPER_EMAIL=super@docs.visibilitybots.com
SEED_SUPER_PASSWORD=Super@12345
SEED_ADMIN_EMAIL=admin@docs.visibilitybots.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_TEAM_EMAIL=team@docs.visibilitybots.com
SEED_TEAM2_EMAIL=team2@docs.visibilitybots.com
SEED_TEAM_PASSWORD=Team@12345
SEED_ADMIN_FULLNAME=Docs AI Admin
ALLOW_LOCAL_SEED=true
